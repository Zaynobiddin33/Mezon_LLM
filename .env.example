# copy to .env and export, or set in your process manager
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# demo | openai | http | dotted.path.ToAnalyzer
MEZON_AI_BACKEND=demo
MEZON_AI_URL=http://127.0.0.1:8000/v1
MEZON_AI_MODEL=mezon-qonun
MEZON_AI_API_KEY=
MEZON_AI_TIMEOUT=180
